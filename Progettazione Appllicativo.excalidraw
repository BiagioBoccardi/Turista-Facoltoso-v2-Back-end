    {
      "id": "Sypf98Zs6qMnbgcZDrlv-",
      "type": "text",
      "x": 1151.5374616566994,
      "y": 613.9708125564298,
      "width": 795.2222900390625,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
