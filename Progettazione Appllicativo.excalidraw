      "boundElements": [],
      "updated": 1769696476641,
      "link": null,
      "locked": false,
      "text": "SELECT *\n           FROM ABITAZIONI\n                                                        JOIN HOST ON ABITAZIONI.codice_host = HOST.codice_host\n                                        WHERE HOST.codice_host = '(codice_host)';",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT *\n           FROM ABITAZIONI\n                                                        JOIN HOST ON ABITAZIONI.codice_host = HOST.codice_host\n                                        WHERE HOST.codice_host = '(codice_host)';",
