      "isDeleted": false,
      "boundElements": [],
      "updated": 1769695857942,
      "link": null,
      "locked": false,
      "text": "        SELECT *\n                        FROM PRENOTAZIONI\n                                                                               JOIN UTENTI ON PRENOTAZIONI.id_utente = UTENTI.id_utente\n                                                                  WHERE PRENOTAZIONI.id_utente = 'valore_desiderato'\n                                           ORDER BY data_prenotazione DESC\n         LIMIT 1\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "        SELECT *\n                        FROM PRENOTAZIONI\n                                                                               JOIN UTENTI ON PRENOTAZIONI.id_utente = UTENTI.id_utente\n                                                                  WHERE PRENOTAZIONI.id_utente = 'valore_desiderato'\n                                           ORDER BY data_prenotazione DESC\n         LIMIT 1\n\n",
      "autoResize": true,
      "lineHeight": 1.25
