      "updated": 1769697373054,
      "link": null,
      "locked": false,
      "text": "Ottenere tutti i super-host:\n\nSELECT H.*\nFROM HOST H\nJOIN PRENOTAZIONI P ON H.id_utente = P.id_utente\nGROUP BY H.id_utente\nHAVING COUNT(P.id) >= 100;\n\n ",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ottenere tutti i super-host:\n\nSELECT H.*\nFROM HOST H\nJOIN PRENOTAZIONI P ON H.id_utente = P.id_utente\nGROUP BY H.id_utente\nHAVING COUNT(P.id) >= 100;\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
