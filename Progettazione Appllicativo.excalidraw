      "seed": 1817063943,
      "version": 165,
      "versionNonce": 1643951655,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769783895595,
      "link": null,
      "locked": false,
      "text": "Abitazioni di un certo codice host\n\n✔ Requisito rispettato se:\n\nl’interfaccia permette di inserire un codice host\n\nl’utente può avviare la ricerca\n\nvengono mostrate solo le abitazioni di quell’host\n\n📌 Basta:\n\n1 campo input\n\n1 bottone\n\n1 elenco/tabella",
      "fontSize": 26.415541080703807,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Abitazioni di un certo codice host\n\n✔ Requisito rispettato se:\n\nl’interfaccia permette di inserire un codice host\n\nl’utente può avviare la ricerca\n\nvengono mostrate solo le abitazioni di quell’host\n\n📌 Basta:\n\n1 campo input\n\n1 bottone\n\n1 elenco/tabella",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "8sY3AhlSgmjXm6L6mp5Q1",
      "type": "text",
      "x": 1975.8372701126364,
      "y": 1607.24548074614,
      "width": 558.3918230491701,
      "height": 477.37804375743866,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#a5d8ff",
